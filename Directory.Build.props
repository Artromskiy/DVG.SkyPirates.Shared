<Project>
    <PropertyGroup>
        <!-- In the Unity submodule checkout, keep generated C# files outside Assets. -->
        <BaseIntermediateOutputPath Condition="Exists('$(MSBuildThisFileDirectory)../../../../ProjectSettings/ProjectVersion.txt')">$(MSBuildThisFileDirectory)../../../../Temp/obj/SkyPirates.Shared/</BaseIntermediateOutputPath>
        <MSBuildProjectExtensionsPath Condition="Exists('$(MSBuildThisFileDirectory)../../../../ProjectSettings/ProjectVersion.txt')">$(MSBuildThisFileDirectory)../../../../Temp/obj/SkyPirates.Shared/</MSBuildProjectExtensionsPath>
        <BaseOutputPath Condition="Exists('$(MSBuildThisFileDirectory)../../../../ProjectSettings/ProjectVersion.txt')">$(MSBuildThisFileDirectory)../../../../Temp/bin/SkyPirates.Shared/</BaseOutputPath>
    </PropertyGroup>
</Project>
